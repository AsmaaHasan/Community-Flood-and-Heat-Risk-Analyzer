# Community Flood and Heat Risk Analyzer - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# DATABASE CONFIGURATION (Required for user features)
# ==============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/flood_heat_analyzer

# Individual PostgreSQL connection parameters (auto-set on Replit)
PGHOST=localhost
PGPORT=5432
PGUSER=analyzer_user
PGPASSWORD=your_secure_password
PGDATABASE=flood_heat_analyzer

# ==============================================================================
# API KEYS (Optional - system uses demo data if not provided)
# ==============================================================================

# OpenWeatherMap API Key
# Get your free key at: https://openweathermap.org/api
# Free tier: 1,000 calls/day, 5-day forecast
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NewsAPI Key
# Get your free key at: https://newsapi.org/register
# Free tier: 100 requests/day, 1 month history
NEWSAPI_KEY=your_newsapi_key_here

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Session secret for authentication (generate a random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your_random_secret_key_here

# Application environment (development/production)
APP_ENV=development

# ==============================================================================
# OPTIONAL ADVANCED CONFIGURATION
# ==============================================================================

# Streamlit caching TTL (in seconds) - default: 600
CACHE_TTL=600

# Database connection pool size - default: 5
DB_POOL_SIZE=5

# Database max overflow connections - default: 10
DB_MAX_OVERFLOW=10

# API request timeout (in seconds) - default: 10
API_TIMEOUT=10

# Maximum API retry attempts - default: 3
API_MAX_RETRIES=3

# Enable SQL query logging (true/false) - default: false
SQL_ECHO=false

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Never commit .env file to version control (it's in .gitignore)
# 2. On Replit, use the Secrets tab instead of .env file
# 3. API keys are optional - system works with demonstration data
# 4. For production, use strong SESSION_SECRET and secure passwords
# 5. Keep DATABASE_URL and API keys secure and private
